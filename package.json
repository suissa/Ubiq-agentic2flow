{
  "name": "ubiq-agentic2flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "2Flow parser and multi-framework code generator",
  "scripts": {
    "test": "node --test",
    "check": "node src/cli.js check examples/supplier-to-marketing-customer.2flow",
